{
  "name": "Aulai 01 — Produção (Claude + Canva + HeyGen webhook)",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "aulai-producao", "responseMode": "onReceived", "options": {} },
      "id": "webhook",
      "name": "Webhook Produção",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-80, 380]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "1", "name": "AULAI_URL", "value": "https://aulai.seu-dominio.com", "type": "string" },
            { "id": "2", "name": "courseId", "value": "={{ $json.body.courseId }}", "type": "string" },
            { "id": "3", "name": "brief", "value": "={{ $json.body.brief }}", "type": "object" },
            { "id": "4", "name": "BRAND_TEMPLATE_ID", "value": "SEU_BRAND_TEMPLATE_ID", "type": "string" },
            { "id": "5", "name": "HEYGEN_AVATAR_ID", "value": "SEU_AVATAR_ID", "type": "string" },
            { "id": "6", "name": "HEYGEN_VOICE_ID", "value": "SEU_VOICE_ID", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "config",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [140, 380]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "anthropic-version", "value": "2023-06-01" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-opus-4-7', max_tokens: 8000, system: 'Você é um designer instrucional. Gere um curso completo em JSON. CONFORMIDADE CFM 2.336/2023: identificação obrigatória (nome, CRM+UF, RQE, máx 2 especialidades), proibido prometer resultado ou sensacionalismo, anonimato de pacientes, equipamentos só conforme ANVISA. Saída APENAS JSON: {\"subtitle\":\"\",\"audience\":\"\",\"promise\":\"\",\"prerequisite\":\"\",\"expectedResult\":\"\",\"format\":\"\",\"complianceNotes\":\"\",\"modules\":[{\"order\":0,\"title\":\"\",\"description\":\"\",\"supportMaterials\":\"\",\"links\":[{\"label\":\"\",\"url\":\"\"}],\"lessons\":[{\"order\":0,\"title\":\"\",\"durationMinutes\":15,\"objective\":\"\",\"script\":\"roteiro temporizado\",\"exercise\":\"\"}]}]}', messages: [{ role: 'user', content: 'Crie o curso completo. Briefing: ' + JSON.stringify($('Config').item.json.brief) }] }) }}",
        "options": {}
      },
      "id": "claude",
      "name": "Claude Gera Currículo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [360, 380],
      "notes": "Credencial: x-api-key = ANTHROPIC_API_KEY"
    },
    {
      "parameters": {
        "assignments": { "assignments": [{ "id": "1", "name": "curriculo", "value": "={{ JSON.parse($json.content[0].text) }}", "type": "object" }] },
        "options": {}
      },
      "id": "extrai",
      "name": "Extrai Currículo",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [580, 380]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $('Config').item.json.AULAI_URL }}/api/courses/{{ $('Config').item.json.courseId }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ subtitle: $json.curriculo.subtitle, audience: $json.curriculo.audience, promise: $json.curriculo.promise, prerequisite: $json.curriculo.prerequisite, expectedResult: $json.curriculo.expectedResult, format: $json.curriculo.format, complianceNotes: $json.curriculo.complianceNotes }) }}",
        "options": {}
      },
      "id": "salva-meta",
      "name": "Aulai Salva Metadados",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [800, 380],
      "notes": "Credencial: x-api-key = SERVICE_API_KEY"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').item.json.AULAI_URL }}/api/courses/{{ $('Config').item.json.courseId }}/curriculum",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ modules: $('Extrai Currículo').item.json.curriculo.modules }) }}",
        "options": {}
      },
      "id": "salva-curriculo",
      "name": "Aulai Salva Currículo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1020, 380],
      "notes": "Resposta traz course.modules[].lessons[] com ids."
    },

    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "version": 2 },
          "conditions": [
            { "id": "a", "leftValue": "={{ $('Config').item.json.BRAND_TEMPLATE_ID }}", "rightValue": "", "operator": { "type": "string", "operation": "notEmpty", "singleValue": true } },
            { "id": "b", "leftValue": "={{ $('Config').item.json.BRAND_TEMPLATE_ID }}", "rightValue": "SEU_BRAND_TEMPLATE_ID", "operator": { "type": "string", "operation": "notEquals" } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-canva-curso",
      "name": "Tem Canva? (curso)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1240, 120],
      "notes": "Capas Canva são opcionais: só rodam se BRAND_TEMPLATE_ID estiver configurado."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "1", "name": "text", "value": "={{ $('Aulai Salva Currículo').item.json.course.title }}", "type": "string" },
            { "id": "2", "name": "brandTemplateId", "value": "={{ $('Config').item.json.BRAND_TEMPLATE_ID }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "cover-curso-in",
      "name": "Capa Curso (input)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1460, 120]
    },
    {
      "parameters": { "source": "database", "workflowId": "REPLACE_COM_ID_DO_WORKFLOW_03", "options": {} },
      "id": "cover-curso",
      "name": "Canva Cover (curso)",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [1460, 200],
      "notes": "Aponte para o workflow 03 (Canva Cover) após importar."
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $('Config').item.json.AULAI_URL }}/api/courses/{{ $('Config').item.json.courseId }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ thumbnailUrl: $json.url }) }}",
        "options": {}
      },
      "id": "patch-curso-thumb",
      "name": "Aulai Capa Curso",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1680, 200]
    },

    {
      "parameters": { "fieldToSplitOut": "course.modules", "options": {} },
      "id": "split-modulos",
      "name": "Split Módulos",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [1240, 480]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "version": 2 },
          "conditions": [
            { "id": "a", "leftValue": "={{ $('Config').item.json.BRAND_TEMPLATE_ID }}", "rightValue": "", "operator": { "type": "string", "operation": "notEmpty", "singleValue": true } },
            { "id": "b", "leftValue": "={{ $('Config').item.json.BRAND_TEMPLATE_ID }}", "rightValue": "SEU_BRAND_TEMPLATE_ID", "operator": { "type": "string", "operation": "notEquals" } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-canva-mod",
      "name": "Tem Canva? (módulo)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1460, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "1", "name": "text", "value": "={{ $('Split Módulos').item.json.title }}", "type": "string" },
            { "id": "2", "name": "brandTemplateId", "value": "={{ $('Config').item.json.BRAND_TEMPLATE_ID }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "cover-mod-in",
      "name": "Capa Módulo (input)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1680, 300]
    },
    {
      "parameters": { "source": "database", "workflowId": "REPLACE_COM_ID_DO_WORKFLOW_03", "options": {} },
      "id": "cover-mod",
      "name": "Canva Cover (módulo)",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [1680, 380]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $('Config').item.json.AULAI_URL }}/api/courses/{{ $('Config').item.json.courseId }}/modules/{{ $('Split Módulos').item.json.id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ thumbnailUrl: $json.url }) }}",
        "options": {}
      },
      "id": "patch-mod-thumb",
      "name": "Aulai Capa Módulo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1900, 380]
    },

    {
      "parameters": { "fieldToSplitOut": "lessons", "options": {} },
      "id": "split-aulas",
      "name": "Split Aulas",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [1460, 620]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.heygen.com/v2/video/generate",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ callback_id: $json.id, video_inputs: [{ character: { type: 'avatar', avatar_id: $('Config').item.json.HEYGEN_AVATAR_ID }, voice: { type: 'text', input_text: $json.script || $json.title, voice_id: $('Config').item.json.HEYGEN_VOICE_ID } }], dimension: { width: 1280, height: 720 } }) }}",
        "options": {}
      },
      "id": "heygen",
      "name": "HeyGen Submete",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1680, 620],
      "notes": "callback_id = id da aula. Use dimension (NÃO aspect_ratio). Credencial: X-Api-Key = HEYGEN_API_KEY. Registre o webhook global do HeyGen apontando p/ {AULAI_URL}/api/webhooks/heygen?secret=HEYGEN_WEBHOOK_SECRET."
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $('Config').item.json.AULAI_URL }}/api/courses/{{ $('Config').item.json.courseId }}/lessons/{{ $('Split Aulas').item.json.id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ heygenRef: $json.data.video_id, videoStatus: 'RENDERING' }) }}",
        "options": {}
      },
      "id": "patch-rendering",
      "name": "Aulai Marca Rendering",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1900, 620],
      "notes": "Fim do workflow. O resto acontece quando o HeyGen chamar o webhook do Aulai (vídeo pronto → READY → quando todas prontas, curso vai p/ AGUARDANDO_APROVACAO e dispara WhatsApp)."
    }
  ],
  "connections": {
    "Webhook Produção": { "main": [[{ "node": "Config", "type": "main", "index": 0 }]] },
    "Config": { "main": [[{ "node": "Claude Gera Currículo", "type": "main", "index": 0 }]] },
    "Claude Gera Currículo": { "main": [[{ "node": "Extrai Currículo", "type": "main", "index": 0 }]] },
    "Extrai Currículo": { "main": [[{ "node": "Aulai Salva Metadados", "type": "main", "index": 0 }]] },
    "Aulai Salva Metadados": { "main": [[{ "node": "Aulai Salva Currículo", "type": "main", "index": 0 }]] },
    "Aulai Salva Currículo": {
      "main": [[
        { "node": "Tem Canva? (curso)", "type": "main", "index": 0 },
        { "node": "Split Módulos", "type": "main", "index": 0 }
      ]]
    },
    "Tem Canva? (curso)": { "main": [[{ "node": "Capa Curso (input)", "type": "main", "index": 0 }], []] },
    "Capa Curso (input)": { "main": [[{ "node": "Canva Cover (curso)", "type": "main", "index": 0 }]] },
    "Canva Cover (curso)": { "main": [[{ "node": "Aulai Capa Curso", "type": "main", "index": 0 }]] },
    "Split Módulos": {
      "main": [[
        { "node": "Tem Canva? (módulo)", "type": "main", "index": 0 },
        { "node": "Split Aulas", "type": "main", "index": 0 }
      ]]
    },
    "Tem Canva? (módulo)": { "main": [[{ "node": "Capa Módulo (input)", "type": "main", "index": 0 }], []] },
    "Capa Módulo (input)": { "main": [[{ "node": "Canva Cover (módulo)", "type": "main", "index": 0 }]] },
    "Canva Cover (módulo)": { "main": [[{ "node": "Aulai Capa Módulo", "type": "main", "index": 0 }]] },
    "Split Aulas": { "main": [[{ "node": "HeyGen Submete", "type": "main", "index": 0 }]] },
    "HeyGen Submete": { "main": [[{ "node": "Aulai Marca Rendering", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
