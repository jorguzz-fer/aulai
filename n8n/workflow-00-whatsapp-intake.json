    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-opus-4-7', max_tokens: 1024, system: $('Config').item.json.INTAKE_PROMPT, messages: [{ role: 'user', content: $json.inputText }] }) }}",
        "options": {}
      },
      "id": "claude-texto",
      "name": "Claude Interpreta (texto)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        280
      ],
      "notes": "Recebe texto OU transcrição de áudio. Credencial: x-api-key = ANTHROPIC_API_KEY"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-opus-4-7', max_tokens: 1024, system: $('Config').item.json.INTAKE_PROMPT, messages: [{ role: 'user', content: [ { type: 'image', source: { type: 'url', url: $('Z-API Webhook').item.json.body.image.imageUrl } }, { type: 'text', text: 'Interprete este pedido de curso. Legenda: ' + ($('Z-API Webhook').item.json.body.image.caption || '(sem legenda)') } ] }] }) }}",
        "options": {}
      },
      "id": "claude-imagem",
      "name": "Claude Interpreta (imagem)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        420
      ],
      "notes": "Visão do Claude lê a imagem. Credencial: x-api-key = ANTHROPIC_API_KEY"
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.content?.[0]?.text ?? '';\nlet brief = null, ok = false, reason = 'Não consegui entender o pedido. Me diz o tema do curso e pra quem é. 🙂';\ntry {\n  brief = JSON.parse(raw);\n  if (brief && brief.ok !== false && brief.title && String(brief.title).trim()) {\n    ok = true;\n  } else if (brief && brief.ok === false && brief.reason) {\n    reason = brief.reason;\n  }\n} catch (e) {}\nreturn [{ json: { ok, brief: brief || {}, reason } }];"
      },
      "id": "valida",
      "name": "Valida Brief",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1500,
        340
      ],
      "notes": "Parseia o JSON do Claude. ok=true só se houver title. Senão devolve reason p/ responder ao usuário."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
