# ── Banco ────────────────────────────────────────────────
DATABASE_URL=postgres://user:pass@localhost:5432/aulai

# ── Auth (NextAuth v5) ───────────────────────────────────
AUTH_SECRET=          # openssl rand -base64 32
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# ── Auth de serviço (n8n → API) ─────────────────────────
SERVICE_API_KEY=      # random hex 32

# ── Eventos de domínio (webhook fire-and-forget) ────────
OUTBOUND_WEBHOOK_URL=https://n8n.exemplo.com/webhook/aulai-eventos
OUTBOUND_WEBHOOK_SECRET=   # random hex 32

# ── Publicação no ClassOS (REST API v1) ─────────────────
CLASSOS_API_URL=https://classos.exemplo.com
# Key POR ESCOLA fica cifrada no Client (use scripts/set-classos-key.ts).
# CLASSOS_API_KEY abaixo é só fallback global (dev / escola única).
CLASSOS_API_KEY=

# Cifra segredos guardados no banco (ex.: Client.classOsApiKey)
SECRET_ENCRYPTION_KEY=   # openssl rand -base64 32

# ── IA / mídia (usados pelos workflows n8n, aqui p/ ref) ─
ANTHROPIC_API_KEY=
HEYGEN_API_KEY=
HEYGEN_WEBHOOK_SECRET=   # protege /api/webhooks/heygen?secret=...
CANVA_API_KEY=
CANVA_BRAND_TEMPLATE_ID= # template de capa (autofill) no Canva
ZAPI_INSTANCE=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# ── Seed inicial ────────────────────────────────────────
SEED_OWNER_EMAIL=owner@aulai.com
SEED_OWNER_PASSWORD=changeme123
SEED_CLIENT_NAME=Cliente Demo

# ── Reset de senha via token (sem email) ────────────────
PASSWORD_RESET_TOKEN=   # random — ativa /login/reset
